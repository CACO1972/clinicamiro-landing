{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self \"https://miro-dx-console.vercel.app\"), microphone=(self \"https://miro-dx-console.vercel.app\")" }
      ]
    }
  ],
  "redirects": [],
  "rewrites": []
}
